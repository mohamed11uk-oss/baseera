  "/api/deep-check/virustotal": {
   "post": {
    "summary": "Deep Check Virustotal",
    "description": "Manual deep check (UI button): read VirusTotal's existing report for one URL. Never part of /api/analyze,\nnever changes the score, never submits the URL to VirusTotal. 4 requests/min (free tier); fails soft.",
