 "components": {
  "schemas": {
   "AnalystLogin": {
    "properties": {
     "token": {
      "type": "string",
      "maxLength": 512,
      "title": "Token"
     }
    },
    "type": "object",
    "required": [
     "token"
    ],
    "title": "AnalystLogin"
   },
   "AnalyzeRequest": {
    "properties": {
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Url"
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text"
     },
     "listing": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Listing"
       },
       {
        "type": "null"
       }
      ]
     },
     "save_case": {
      "type": "boolean",
      "title": "Save Case",
      "default": true
     },
     "deep": {
      "type": "boolean",
      "title": "Deep",
      "description": "Opt-in deep scan: open the URL in the headless Chrome sandbox (screenshot + form fields). Needs live mode and SOURCE_SANDBOX != off.",
      "default": false
     }
    },
    "type": "object",
    "title": "AnalyzeRequest"
   },
   "Cluster": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "case_ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Case Ids"
     },
     "domains": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Domains"
     },
     "entity_ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Entity Ids"
     },
     "shared": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Shared"
     },
     "first_seen": {
      "type": "string",
      "title": "First Seen"
     },
     "last_seen": {
      "type": "string",
      "title": "Last Seen"
     },
     "max_risk": {
      "type": "integer",
      "title": "Max Risk"
     },
     "synthetic": {
      "type": "boolean",
      "title": "Synthetic",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "id",
     "case_ids",
     "domains",
     "entity_ids",
     "shared",
     "first_seen",
     "last_seen",
     "max_risk"
    ],
    "title": "Cluster"
   },
   "DeepCheckRequest": {
    "properties": {
     "url": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1,
      "title": "Url",
      "description": "URL to look up in VirusTotal (manual deep check)"
     }
    },
    "type": "object",
    "required": [
     "url"
    ],
    "title": "DeepCheckRequest"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Listing": {
    "properties": {
     "source": {
      "type": "string",
      "enum": [
       "search",
       "maps",
       "manual"
      ],
      "title": "Source",
      "default": "manual"
     },
     "query": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Query"
     },
     "rank": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Rank"
     },
     "is_ad": {
      "type": "boolean",
      "title": "Is Ad",
      "default": false
     },
     "title": {
      "type": "string",
      "title": "Title"
     },
     "displayed_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Displayed Url"
     },
     "resolved_domain": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Resolved Domain"
     },
     "phone": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Phone"
     },
     "address": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Address"
     },
     "snippet": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Snippet"
     }
    },
    "type": "object",
    "required": [
     "title"
    ],
    "title": "Listing"
   },
   "ListingVerdict": {
    "properties": {
     "listing": {
      "$ref": "#/components/schemas/Listing"
     },
     "verdict": {
      "$ref": "#/components/schemas/Verdict"
     },
     "official": {
      "type": "boolean",
      "title": "Official"
     },
     "reason_ar": {
      "type": "string",
      "title": "Reason Ar"
     },
     "reason_en": {
      "type": "string",
      "title": "Reason En"
     }
    },
    "type": "object",
    "required": [
     "listing",
     "verdict",
     "official",
     "reason_ar",
     "reason_en"
    ],
    "title": "ListingVerdict"
   },
   "ScanBrandRequest": {
    "properties": {
     "brand": {
      "type": "string",
      "title": "Brand"
     },
     "country": {
      "type": "string",
      "title": "Country",
      "default": "AE"
     }
    },
    "type": "object",
    "required": [
     "brand"
    ],
    "title": "ScanBrandRequest"
   },
   "ScanBrandResponse": {
    "properties": {
     "brand": {
      "type": "string",
      "title": "Brand"
     },
     "entity": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Entity"
     },
     "data_label": {
      "type": "string",
      "title": "Data Label"
     },
     "results": {
      "items": {
       "$ref": "#/components/schemas/ListingVerdict"
      },
      "type": "array",
      "title": "Results"
     }
    },
    "type": "object",
    "required": [
     "brand",
     "entity",
     "data_label",
     "results"
    ],
    "title": "ScanBrandResponse"
   },
   "Signal": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "source": {
      "type": "string",
      "title": "Source"
     },
     "score": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "description": "severity 0..1"
     },
     "weight": {
      "type": "number",
      "title": "Weight",
      "default": 0
     },
     "contribution": {
      "type": "number",
      "title": "Contribution",
      "default": 0
     },
     "evidence": {
      "type": "string",
      "title": "Evidence",
      "default": ""
     },
     "available": {
      "type": "boolean",
      "title": "Available",
      "default": true
     },
     "data": {
      "additionalProperties": true,
      "type": "object",
      "title": "Data"
     }
    },
    "type": "object",
    "required": [
     "id",
     "source",
     "score"
    ],
    "title": "Signal"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   },
   "Verdict": {
    "properties": {
     "input": {
      "type": "string",
      "title": "Input"
     },
     "kind": {
      "type": "string",
      "enum": [
       "url",
       "text",
       "listing"
      ],
      "title": "Kind"
     },
     "risk": {
      "type": "integer",
      "title": "Risk"
     },
     "level": {
      "type": "string",
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "title": "Level"
     },
     "signals": {
      "items": {
       "$ref": "#/components/schemas/Signal"
      },
      "type": "array",
      "title": "Signals"
     },
     "explanation_ar": {
      "type": "string",
      "title": "Explanation Ar"
     },
     "explanation_en": {
      "type": "string",
      "title": "Explanation En"
     },
     "matched_entity": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Matched Entity"
     },
     "normalized": {
      "additionalProperties": true,
      "type": "object",
      "title": "Normalized"
     },
     "sub_verdicts": {
      "items": {
       "$ref": "#/components/schemas/Verdict"
      },
      "type": "array",
      "title": "Sub Verdicts"
     },
     "campaign_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Campaign Id"
     },
     "case_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Case Id"
     },
     "screenshot_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Screenshot Url"
     },
     "mode": {
      "type": "string",
      "title": "Mode",
      "default": "live"
     },
     "analyzed_at": {
      "type": "string",
      "title": "Analyzed At",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "input",
     "kind",
     "risk",
     "level",
     "signals",
     "explanation_ar",
     "explanation_en"
    ],
    "title": "Verdict"
   }
  }
