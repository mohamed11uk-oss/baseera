# Copy to .env (never commit .env). All sources are optional; Baseera works offline without any key.
BASEERA_MODE=live          # live | offline
BASEERA_TIMEOUT=4
SOURCE_RDAP=on
SOURCE_TLS=on
SOURCE_REDIRECTS=on
SERPAPI_KEY=               # SERPAPI_API_KEY is accepted too. This file (.env) is loaded automatically; BASEERA_DOTENV=off disables it
GSB_API_KEY=
# Threat-intel sources (all optional, all fail soft; see docs/DECISIONS.md)
SOURCE_FEEDS=on            # PhishTank/OpenPhish local DB (fill it with: python -m baseera feeds refresh)
PHISHTANK_APP_KEY=
SOURCE_CRTSH=on            # crt.sh domain-age fallback (6s, 2 retries)
SOURCE_WHOIS_AE=on         # .ae WHOIS on port 43 (often blocked)
SOURCE_GSB=on              # Google Safe Browsing: only active when GSB_API_KEY is set
GSB_DAILY_LIMIT=10000
# Optional key-gated sources: OFF by default. Set SOURCE_*=on AND the key to enable (live mode only).
SOURCE_URLHAUS=off         # abuse.ch URLhaus URL/host lookup (in /api/analyze)
URLHAUS_AUTH_KEY=
SOURCE_URLSCAN=off         # urlscan.io: read existing scans only (informational, never submits)
URLSCAN_API_KEY=
SOURCE_VT=off              # VirusTotal: manual "deep check" button only, never in /api/analyze
VT_API_KEY=
VT_PER_MINUTE=4            # free public API limit
ANTHROPIC_API_KEY=         # not used yet
# Security (optional). Set ANALYST_TOKEN (long random string) before exposing the server beyond localhost:
# it then protects /api/cases*, /api/clusters and the evidence packs.
ANALYST_TOKEN=
BASEERA_MAX_BODY_BYTES=65536
BASEERA_ALLOWED_HOSTS=     # e.g. 127.0.0.1,localhost (DNS-rebinding defence); empty = any Host header
